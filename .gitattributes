*.png filter=lfs diff=lfs merge=lfs -text

# Enforce LF line endings on all text files for cross-platform usability.
# Prevents `bash: ./script.sh: /bin/zsh^M: bad interpreter` on Linux/WSL clones.
* text=auto eol=lf
*.sh text eol=lf
*.zsh text eol=lf
*.bash text eol=lf
*.ps1 text eol=crlf
*.toml text eol=lf
*.lua text eol=lf
*.rasi text eol=lf
*.ini text eol=lf
*.conf text eol=lf
*.el text eol=lf
dot-* text eol=lf
